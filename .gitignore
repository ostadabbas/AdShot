# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv


# --- from mllm project ---
.env
/data_archive
/data
/temp_dir
/tmp_archives
/clustering_code
label_handles.ipynb
rebatch.ipynb
_leaky_test.sqlite
upload.txt
youtube_cookies.txt
*_rsync.log
*_rsync_selected.log

# Vendored model checkpoints (kept on disk, out of git)
pair_extraction/models/*.pth

# pair_extraction runtime artifacts (regenerated; not source)
pair_extraction/logs/
pair_extraction/data/
pair_extraction/*.log

# Python / notebook caches
__pycache__/
.ipynb_checkpoints/

# W&B local run logs (training metrics live on wandb.ai, not in git)
wandb/

# qwen_pipeline large artifacts (weights, keyframe cache, frames, logs) — out of git
qwen_pipeline/keyframes/*.h5
qwen_pipeline/training/runs/qwen3vl8b_lora_*/
qwen_pipeline/data/frames/
qwen_pipeline/logs/
qwen_pipeline/**/*.log
# model weights anywhere under qwen_pipeline
qwen_pipeline/**/*.safetensors
qwen_pipeline/**/*.bin
qwen_pipeline/**/*.pt
qwen_pipeline/**/*.pth
# result backups / partial dumps (keep clean results only)
qwen_pipeline/results/*.bak_*
qwen_pipeline/results/*.bak
qwen_pipeline/results/*partial_oom*

video_curation/data/
